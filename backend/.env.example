DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=disaster_management
DB_USER=disaster_user
DB_PASSWORD=replace_with_private_app_password
DB_TIME_ZONE=+05:30
# Optional DATABASE_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/disaster_management
# DATABASE_URL takes precedence over DB_* if set.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
COOKIE_SECURE=false
SESSION_HOURS=8

# Optional map/geocoder configuration (no paid key required)
GEOCODING_ENABLED=true
GEOCODING_URL=https://photon.komoot.io/api/
GEOCODING_USER_AGENT=DMS-College-Project/2.0
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
